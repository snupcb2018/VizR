# VizR Production Dockerfile
FROM node:22

# 기본 패키지 설치
RUN apt-get update && apt-get install -y \
    bash \
    coreutils \
    python3 python3-venv python3-pip \
    curl \
    wget \
    unzip \
    fastqc \
    prinseq-lite \
    hisat2 \
    stringtie \
    samtools \
    openjdk-17-jre-headless \
    sudo \
    vim \
    git \
    sra-toolkit \
    redis-server \
 && curl -fsSL https://download.docker.com/linux/debian/gpg | apt-key add - \
 && echo "deb [arch=amd64] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y docker-ce-cli \
 && rm -rf /var/lib/apt/lists/*

# Trimmomatic 수동 설치 및 wrapper 스크립트 생성
RUN cd /opt \
 && wget -q http://www.usadellab.org/cms/uploads/supplementary/Trimmomatic/Trimmomatic-0.39.zip \
 && unzip -q Trimmomatic-0.39.zip \
 && rm Trimmomatic-0.39.zip \
 && echo '#!/usr/bin/bash' > /usr/local/bin/trimmomatic \
 && echo 'java -jar /opt/Trimmomatic-0.39/trimmomatic-0.39.jar "$@"' >> /usr/local/bin/trimmomatic \
 && chmod +x /usr/local/bin/trimmomatic

# hjung 사용자 생성
RUN groupadd -g 1002 hjung && \
    useradd -u 1002 -g 1002 -m -s /usr/bin/bash hjung && \
    usermod -aG sudo hjung && \
    echo 'hjung ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# 작업 디렉토리 생성
WORKDIR /app

# Python 의존성 설치
COPY requirements.txt /app/
RUN python3 -m venv /opt/venvs/vizr \
    && /opt/venvs/vizr/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venvs/vizr/bin/pip install --no-cache-dir -r requirements.txt

# 소스코드 복사 (배포용 핵심 차이점)
COPY --chown=hjung:hjung . /app/

# Frontend 빌드
RUN cd /app/frontend \
    && npm install \
    && npm run build

# 환경변수 설정
ENV PATH="/opt/venvs/vizr/bin:${PATH}"
ENV MODE=production
ENV VIZR_PATH=/vizr
ENV VIZR_WORKBENCH_PATH=/vizr/workbench

# 필요한 디렉토리 생성
RUN mkdir -p /vizr/workbench && chown -R hjung:hjung /vizr

# 포트 노출
EXPOSE 5001

# 실행
USER hjung
CMD ["/usr/bin/bash", "/app/start.sh"]
